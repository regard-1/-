# 百炼模型 API 密钥（必填）
STUDIO_LLM_API_KEY=

# 百炼模型接口地址（固定）
STUDIO_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 截图识别使用的视觉模型
STUDIO_VISION_MODEL=qwen3.5-ocr

# 多特倍斯百炼知识库（密钥只放服务端，不要提交）
BAILIAN_KB_API_KEY=
BAILIAN_KB_BASE_URL=https://ws-5ir7z45ox2wmnbb4.cn-beijing.maas.aliyuncs.com
BAILIAN_KB_AGENT_ID=aid-56fd229f52354d75af21e38ee208fa8a
BAILIAN_KB_TOP_K=5

# 本地开发端口（可选，默认61279）
STUDIO_PORT=61279

# 管理员初始化（首次部署时填写，之后可删除）
STUDIO_BOOTSTRAP_USERNAME=admin
STUDIO_BOOTSTRAP_PASSWORD_HASH=

# 飞书告警 webhook（可选）
FEISHU_BOT_WEBHOOK=

# 句子互动企业级接口（token 只放服务端，不入库不入仓）
WECOM_API_BASE=https://stride-bg.dpclouds.com/hub-api
WECOM_API_TOKEN=
WECOM_API_TIMEOUT_MS=15000

# 句子互动 iframe SSO / 自建 IDP（全部只放服务端，不入仓）
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=
IDP_REDIRECT_URI=
IDP_EMAIL_DOMAIN=
IDP_ORG_ID=
SP_BASE_URL=
SP_SSO_PATH=
SP_REDIRECT_PATH=/main/:orgId/member-crm/:groupId/contact-list
SP_ALLOWED_ORIGIN=

# 生产 PostgreSQL 连接串（只放服务端，不入库不入仓）
DATABASE_URL=
